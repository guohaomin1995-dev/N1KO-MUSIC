<?xml version="1.0" encoding="utf-8"?>
<!--
    大号小部件只有一行高时（4×1）：封面、歌名歌手（下面一条进度条）、三个按钮、收藏排成一行。
    按钮紧挨着排（不平分），留白和按钮都是小一号的；窄了先收起收藏、再不放封面（见 WidgetLayouts）。
    玻璃底三层和 widget_small 一样。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg"
        style="@style/WidgetGlass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_glass_default" />

    <ImageView
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_scrim" />

    <ImageView
        android:id="@+id/widget_sheen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_sheen" />

    <LinearLayout
        android:id="@+id/widget_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/widget_padding_compact">

        <!-- 正方形，边长跟着高度走（大小的道理见 widget_large） -->
        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/widget_gap"
            android:adjustViewBounds="true"
            android:background="@drawable/widget_cover_outline"
            android:clipToOutline="true"
            android:contentDescription="@string/widget_cover"
            android:foreground="@drawable/widget_cover_edge"
            android:maxWidth="@dimen/widget_cover_max"
            android:maxHeight="@dimen/widget_cover_max"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cover_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#8C000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:singleLine="true"
                android:text="@string/widget_idle_title"
                android:textColor="#FFFFFFFF"
                android:textSize="@dimen/widget_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:shadowColor="#8C000000"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:singleLine="true"
                android:text="@string/widget_idle_hint"
                android:textColor="#CCFFFFFF"
                android:textSize="@dimen/widget_artist" />

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_progress"
                android:layout_marginTop="5dp"
                android:layoutDirection="ltr"
                android:max="1000"
                android:maxHeight="@dimen/widget_progress"
                android:minHeight="@dimen/widget_progress"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>

        <!-- 播放按钮永远从左到右（上一首在左）；收藏在外面，跟着语言的方向 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="@dimen/widget_button_compact"
                android:layout_height="@dimen/widget_button_compact"
                android:background="@drawable/widget_press"
                android:contentDescription="@string/widget_previous"
                android:padding="@dimen/widget_button_pad_compact"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_prev" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="@dimen/widget_play_compact"
                android:layout_height="@dimen/widget_play_compact"
                android:background="@drawable/widget_play_bg"
                android:contentDescription="@string/widget_play"
                android:padding="@dimen/widget_play_pad_compact"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_play" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="@dimen/widget_button_compact"
                android:layout_height="@dimen/widget_button_compact"
                android:background="@drawable/widget_press"
                android:contentDescription="@string/widget_next"
                android:padding="@dimen/widget_button_pad_compact"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_next" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_heart"
            android:layout_width="@dimen/widget_heart"
            android:layout_height="@dimen/widget_heart"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="-4dp"
            android:background="@drawable/widget_press"
            android:contentDescription="@string/widget_favorite"
            android:padding="@dimen/widget_heart_pad"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_heart" />
    </LinearLayout>
</FrameLayout>
