<?xml version="1.0" encoding="utf-8"?>
<!--
    盖在玻璃底上的反光和描边，矢量画的：小部件多大都是锐利的。
    上沿亮一点、往下收掉、底部略暗，像一块有厚度的玻璃；外面一圈细的高光。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <gradient
                android:angle="270"
                android:centerColor="#05FFFFFF"
                android:centerY="0.4"
                android:endColor="#24000000"
                android:startColor="#2BFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_radius" />
            <stroke
                android:width="1dp"
                android:color="#42FFFFFF" />
        </shape>
    </item>
</layer-list>
